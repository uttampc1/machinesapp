[Unit]
Description=Machine Invenstory Server
After=network.target

[Service]
User=upawar
Group=upawar
WorkingDirectory=/opt/machinesapp
Environment="MACHINES_DB_PATH=/var/lib/machinesapp/machines.db"
Environment="PATH=/opt/machinesapp/venv/bin"
ExecStart=/opt/machinesapp/venv/bin/python app.py
Restart=always

[Install]
WantedBy=multi-user.target

